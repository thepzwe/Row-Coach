          </div>

          <div class="angle-row">
            <span class="angle-name">Elbow</span>

            <div class="angle-bar-wrap">
              <div class="angle-bar" id="bar-elbow" style="width: 0%"></div>
            </div>

            <span class="angle-val" id="ang-elbow">--</span>
          </div>
        </div>
      </div>
    </div>
  </body>
</html>
<!-- Stick figure -->

<div class="card">

  <div class="card-title">Athlete position</div>
  
  <div class="stick-wrap">
  
  <canvas id="stickCanvas" width="200" height="140"></canvas>
  
  </div>
  
  </div>
  
  
  
  <!-- AI deep feedback -->
  
  <div class="section-sep">AI coaching notes</div>
  
  <div id="feedbackWrap">
  
  <div style="font-size: 12px; color: #444">
  
  Hit "Analyse now" for detailed AI feedback.
  
  </div>
  
  </div>
  
  </div>
  
  </div>
  
  
  
  <script src="https://cdn.jsdelivr.net/npm/@mediapipe/pose@0.5.1675469404/pose.js"></script>
  
  <script src="https://cdn.jsdelivr.net/npm/@mediapipe/camera_utils@0.3.1675466862/camera_utils.js"></script>
  
  
  
  <script>
  
  const video = document.getElementById("video");
  
  const overlayC = document.getElementById("overlay");
  
  const ctx = overlayC.getContext("2d");
  
  const stickC = document.getElementById("stickCanvas");
  
  const sCtx = stickC.getContext("2d");
  
  const dot = document.getElementById("dot");
  
  const statusTxt = document.getElementById("statusTxt");
  
  const phaseTxt = document.getElementById("phaseTxt");
  
  const noCam = document.getElementById("noCam");
  
  const aiOverlay = document.getElementById("aiOverlay");
  
  const btnAnalyse = document.getElementById("btnAnalyse");
  
  const btnLive = document.getElementById("btnLive");
  
  const btnStart = document.getElementById("btnStart");
  
  const btnStop = document.getElementById("btnStop");
  
  const camSelect = document.getElementById("camSelect");
  
  const liveFbWrap = document.getElementById("liveFbWrap");
  
  
  
  let stream = null,
  
  poseInst = null,
  
  mpCamera = null;
  
  let lastAngles = {};
  
  let isAnalysing = false,
  
  liveOn = false,
  
  liveTimer = null;
  
  let camListPopulated = false; // prevent re-populating mid-session
  
  
  
  // =====================================================================
  
  // CAMERA ENUMERATION
  
  // Key fix: we only repopulate the list when NOT currently streaming,
  
  // so switching cameras while live doesn't reset the dropdown.
  
  // =====================================================================
  
  async function loadCameras(preserveValue) {
  
  const devices = await navigator.mediaDevices.enumerateDevices();
  
  const cams = devices.filter((d) => d.kind === "videoinput");
  
  if (cams.length === 0) {
  
  camSelect.innerHTML = '<option value="">No cameras found</option>';
  
  return;
  
  }
  
  const saved = preserveValue || camSelect.value;
  
  camSelect.innerHTML = "";
  
  cams.forEach((cam, i) => {
  
  const opt = document.createElement("option");
  
  opt.value = cam.deviceId;
  
  opt.textContent = cam.label || "Camera " + (i + 1);
  
  camSelect.appendChild(opt);
  
  });
  
  // Restore previously selected camera
  
  if (saved) {
  
  const match = Array.from(camSelect.options).find(
  
  (o) => o.value === saved
  
  );
  
  if (match) camSelect.value = saved;
  
  }
  
  }
  
  
  
  // Initial load — labels will be blank until permission granted
  
  loadCameras();
  
  
  
  // When user picks a different camera while running, switch immediately
  
  camSelect.addEventListener("change", () => {
  
  if (stream) {
  
  const chosen = camSelect.value;
  
  stopCam(true); // silent stop — don't reset the dropdown
  
  startCamWithDevice(chosen);
  
  }
  
  });
  
  
  
  // =====================================================================
  
  // MATHS
  
  // =====================================================================
  
  function angleBetween(a, b, c) {
  
  const ab = { x: a.x - b.x, y: a.y - b.y };
  
  const cb = { x: c.x - b.x, y: c.y - b.y };
  
  const d = ab.x * cb.x + ab.y * cb.y;
  
  const mag =
  
  Math.sqrt(ab.x ** 2 + ab.y ** 2) * Math.sqrt(cb.x ** 2 + cb.y ** 2);
  
  if (mag === 0) return 0;
  
  return Math.round(
  
  (Math.acos(Math.max(-1, Math.min(1, d / mag))) * 180) / Math.PI
  
  );
  
  }
  
  function angleFromVertical(a, b) {
  
  return Math.round(
  
  Math.abs((Math.atan2(b.x - a.x, b.y - a.y) * 180) / Math.PI)
  
  );
  
  }
  
  function setStatus(txt, mode) {
  
  statusTxt.textContent = txt;
  
  dot.className = "dot" + (mode ? " " + mode : "");
  
  }
  
  
  
  // =====================================================================
  
  // LIVE RULE-BASED FEEDBACK (runs every frame, no API call)
  
  // =====================================================================
  
  function getLiveFeedback(ang) {
  
  const items = [];
  
  
  
  // Shin angle at catch
  
  if (ang.shin > 30) {
  
  items.push({
  
  type: "warn",
  
  label: "Shin angle",
  
  text: "Shins past vertical — slide forward more at the catch to get full compression.",
  
  });
  
  } else {
  
  items.push({
  
  type: "good",
  
  label: "Shin angle",
  
  text: "Good shin angle. Solid catch position.",
  
  });
  
  }
  
  
  
  // Torso layback
  
  if (ang.torso < 15) {
  
  items.push({
  
  type: "warn",
  
  label: "Layback",
  
  text: "Not enough layback — lean back slightly more at the finish to complete the drive.",
  
  });
  
  } else if (ang.torso > 50) {
  
  items.push({
  
  type: "bad",
  
  label: "Layback",
  
  text: "Too much layback. Over-reaching strains your lower back and loses power.",
  
  });
  
  } else {
  
  items.push({
  
  type: "good",
  
  label: "Layback",
  
  text: "Layback looks good.",
  
  });
  
  }
  
  
  
  // Elbow bend at finish
  
  if (ang.elbow < 120) {
  
  items.push({
  
  type: "good",
  
  label: "Arms",
  
  text: "Good arm draw — elbows pulled through well.",
  
  });
  
  } else if (ang.elbow > 160) {
  
  items.push({
  
  type: "warn",
  
  label: "Arms",
  
  text: "Arms still extended — make sure to finish the draw with elbows past your body.",
  
  });
  
  }
  
  
  
  // Hip angle
  
  if (ang.hip < 50) {
  
  items.push({
  
  type: "warn",
  
  label: "Hip compression",
  
  text: "Very compressed hip — ensure you open the hip fully on the drive.",
  
  });
  
  }
  
  
  
  // Knee extension
  
  if (ang.knee > 160) {
  
  items.push({
  
  type: "good",
  
  label: "Leg drive",
  
  text: "Full leg extension. Great power through the drive.",
  
  });
  
  } else if (ang.knee < 80) {
  
  items.push({
  
  type: "warn",
  
  label: "Leg drive",
  
  text: "Knees still bent — drive legs to full extension before opening hips.",
  
  });
  
  }
  
  
  
  return items.slice(0, 4);
  
  }
  
  
  
  function renderLiveFeedback(ang) {
  
  const items = getLiveFeedback(ang);
  
  liveFbWrap.innerHTML = items
  
  .map(
  
  (f) =>
  
  '<div class="live-fb ' +
  
  f.type +
  
  '"><div class="live-fb-label">' +
  
  f.label +
  
  "</div>" +
  
  f.text +
  
  "</div>"
  
  )
  
  .join("");
  
  }
  
  
  
  // =====================================================================
  
  // ANGLES & PHASE
  
  // =====================================================================
  
  function updateAngles(lm) {
  
  const hip = lm[23],
  
  knee = lm[25],
  
  ankle = lm[27];
  
  const shoulder = lm[11],
  
  elbow = lm[13],
  
  wrist = lm[15];
  
  
  
  lastAngles = {
  
  shin: angleFromVertical(knee, ankle),
  
  torso: angleFromVertical(hip, shoulder),
  
  hip: angleBetween(shoulder, hip, knee),
  
  knee: angleBetween(hip, knee, ankle),
  
  elbow: angleBetween(shoulder, elbow, wrist),
  
  };
  
  
  
  function setAngle(id, val, min, max, gMin, gMax) {
  
  document.getElementById("ang-" + id).textContent = val + "\u00b0";
  
  const pct = Math.round(
  
  Math.min(100, Math.max(0, ((val - min) / (max - min)) * 100))
  
  );
  
  const bar = document.getElementById("bar-" + id);
  
  bar.style.width = pct + "%";
  
  bar.className =
  
  "angle-bar " + (val >= gMin && val <= gMax ? "good" : "warn");
  
  }
  
  setAngle("shin", lastAngles.shin, 0, 90, 0, 25);
  
  setAngle("torso", lastAngles.torso, 0, 90, 15, 50);
  
  setAngle("hip", lastAngles.hip, 30, 180, 60, 120);
  
  setAngle("knee", lastAngles.knee, 30, 180, 80, 160);
  
  setAngle("elbow", lastAngles.elbow, 30, 180, 150, 180);
  
  
  
  // Phase
  
  let phase = "recovery";
  
  if (lastAngles.knee < 70) phase = "catch";
  
  else if (lastAngles.knee > 150 && lastAngles.elbow > 155)
  
  phase = "finish";
  
  else if (lastAngles.knee < 130 && lastAngles.elbow > 140)
  
  phase = "drive";
  
  phaseTxt.textContent = phase.charAt(0).toUpperCase() + phase.slice(1);
  
  phaseTxt.style.display = "";
  
  
  
  // Live feedback panel (always on when camera is running)
  
  renderLiveFeedback(lastAngles);
  
  }
  
  
  
  // =====================================================================
  
  // SKELETON OVERLAY
  
  // =====================================================================
  
  function drawOverlay(lm) {
  
  const rect = overlayC.getBoundingClientRect();
  
  if (rect.width === 0) return;
  
  overlayC.width = rect.width;
  
  overlayC.height = rect.height;
  
  const W = overlayC.width,
  
  H = overlayC.height;
  
  ctx.clearRect(0, 0, W, H);
  
  
  
  // Mirror to match CSS-flipped video
  
  const m = lm.map((p) => ({
  
  x: 1 - p.x,
  
  y: p.y,
  
  visibility: p.visibility,
  
  }));
  
  
  
  const groups = [
  
  {
  
  conns: [
  
  [11, 13],
  
  [13, 15],
  
  ],
  
  color: "#5DCAA5",
  
  },
  
  {
  
  conns: [
  
  [12, 14],
  
  [14, 16],
  
  ],
  
  color: "#5DCAA5",
  
  },
  
  {
  
  conns: [
  
  [11, 23],
  
  [23, 25],
  
  [25, 27],
  
  ],
  
  color: "#378ADD",
  
  },
  
  {
  
  conns: [
  
  [12, 24],
  
  [24, 26],
  
  [26, 28],
  
  ],
  
  color: "#378ADD",
  
  },
  
  {
  
  conns: [
  
  [11, 12],
  
  [23, 24],
  
  ],
  
  color: "#666",
  
  },
  
  ];
  
  
  
  for (const { conns, color } of groups) {
  
  for (const [a, b] of conns) {
  
  const p1 = m[a],
  
  p2 = m[b];
  
  if (!p1 || !p2 || p1.visibility < 0.3 || p2.visibility < 0.3)
  
  continue;
  
  ctx.beginPath();
  
  ctx.moveTo(p1.x * W, p1.y * H);
  
  ctx.lineTo(p2.x * W, p2.y * H);
  
  ctx.strokeStyle = "rgba(0,0,0,0.65)";
  
  ctx.lineWidth = 10;
  
  ctx.lineCap = "round";
  
  ctx.stroke();
  
  ctx.beginPath();
  
  ctx.moveTo(p1.x * W, p1.y * H);
  
  ctx.lineTo(p2.x * W, p2.y * H);
  
  ctx.strokeStyle = color;
  
  ctx.lineWidth = 5;
  
  ctx.stroke();
  
  }
  
  }
  
  
  
  for (const i of [11, 12, 13, 14, 15, 16, 23, 24, 25, 26, 27, 28]) {
  
  const p = m[i];
  
  if (!p || p.visibility < 0.3) continue;
  
  ctx.beginPath();
  
  ctx.arc(p.x * W, p.y * H, 9, 0, Math.PI * 2);
  
  ctx.fillStyle = "rgba(0,0,0,0.55)";
  
  ctx.fill();
  
  ctx.beginPath();
  
  ctx.arc(p.x * W, p.y * H, 7, 0, Math.PI * 2);
  
  ctx.fillStyle = "#fff";
  
  ctx.fill();
  
  ctx.strokeStyle = "#378ADD";
  
  ctx.lineWidth = 2.5;
  
  ctx.stroke();
  
  }
  
  
  
  const nose = m[0];
  
  if (nose && nose.visibility > 0.3) {
  
  ctx.beginPath();
  
  ctx.arc(nose.x * W, nose.y * H, 13, 0, Math.PI * 2);
  
  ctx.fillStyle = "rgba(0,0,0,0.55)";
  
  ctx.fill();
  
  ctx.beginPath();
  
  ctx.arc(nose.x * W, nose.y * H, 11, 0, Math.PI * 2);
  
  ctx.fillStyle = "#fff";
  
  ctx.strokeStyle = "#5DCAA5";
  
  ctx.lineWidth = 2.5;
  
  ctx.fill();
  
  ctx.stroke();
  
  }
  
  
  
  // Angle badges
  
  ctx.font = "bold 13px monospace";
  
  const badges = [
  
  { pt: m[25], val: lastAngles.shin },
  
  { pt: m[23], val: lastAngles.hip },
  
  { pt: m[11], val: lastAngles.torso },
  
  ];
  
  for (const { pt, val } of badges) {
  
  if (!pt || val === undefined || pt.visibility < 0.3) continue;
  
  const txt = val + "\u00b0";
  
  const x = pt.x * W + 12,
  
  y = pt.y * H;
  
  const tw = ctx.measureText(txt).width + 12;
  
  ctx.fillStyle = "rgba(0,0,0,0.78)";
  
  ctx.beginPath();
  
  ctx.roundRect(x, y - 11, tw, 22, 5);
  
  ctx.fill();
  
  ctx.fillStyle = "#facc15";
  
  ctx.fillText(txt, x + 6, y + 5);
  
  }
  
  }
  
  
  
  // =====================================================================
  
  // STICK FIGURE
  
  // =====================================================================
  
  function drawStick(lm) {
  
  const W = stickC.width,
  
  H = stickC.height;
  
  sCtx.clearRect(0, 0, W, H);
  
  const keys = {
  
  nose: 0,
  
  lShoulder: 11,
  
  rShoulder: 12,
  
  lHip: 23,
  
  rHip: 24,
  
  lKnee: 25,
  
  rKnee: 26,
  
  lAnkle: 27,
  
  rAnkle: 28,
  
  lElbow: 13,
  
  rElbow: 14,
  
  lWrist: 15,
  
  rWrist: 16,
  
  };
  
  const pts = {};
  
  for (const [k, i] of Object.entries(keys)) {
  
  if (lm[i]) pts[k] = { x: (1 - lm[i].x) * W, y: lm[i].y * H };
  
  }
  
  function line(a, b, col, w) {
  
  if (!pts[a] || !pts[b]) return;
  
  sCtx.beginPath();
  
  sCtx.moveTo(pts[a].x, pts[a].y);
  
  sCtx.lineTo(pts[b].x, pts[b].y);
  
  sCtx.strokeStyle = col;
  
  sCtx.lineWidth = w || 2.5;
  
  sCtx.lineCap = "round";
  
  sCtx.stroke();
  
  }
  
  line("lShoulder", "lHip", "#378ADD");
  
  line("lHip", "lKnee", "#378ADD");
  
  line("lKnee", "lAnkle", "#378ADD");
  
  line("lShoulder", "lElbow", "#5DCAA5");
  
  line("lElbow", "lWrist", "#5DCAA5");
  
  line("lShoulder", "rShoulder", "#444", 1.5);
  
  line("lHip", "rHip", "#444", 1.5);
  
  for (const [k, p] of Object.entries(pts)) {
  
  sCtx.beginPath();
  
  sCtx.arc(p.x, p.y, k === "nose" ? 7 : 3.5, 0, Math.PI * 2);
  
  sCtx.fillStyle = k === "nose" ? "#e0e0e0" : "#378ADD";
  
  sCtx.strokeStyle = "#378ADD";
  
  sCtx.lineWidth = 1.5;
  
  k === "nose" ? (sCtx.fill(), sCtx.stroke()) : sCtx.fill();
  
  }
  
  }
  
  
  
  // =====================================================================
  
  // CAMERA START / STOP
  
  // =====================================================================
  
  async function startCam() {
  
  // First, ask for permission — this also populates labels
  
  let tmp;
  
  try {
  
  tmp = await navigator.mediaDevices.getUserMedia({
  
  video: true,
  
  audio: false,
  
  });
  
  } catch (e) {
  
  alert(
  
  "Camera permission denied.\n\nFix: Open this page in a new browser tab instead of the CodeSandbox preview panel. The preview iframe blocks camera access."
  
  );
  
  return;
  
  }
  
  tmp.getTracks().forEach((t) => t.stop());
  
  
  
  // Now populate dropdown with real labels and pick chosen device
  
  await loadCameras();
  
  const chosen = camSelect.value;
  
  await startCamWithDevice(chosen);
  
  }
  
  
  
  async function startCamWithDevice(deviceId) {
  
  const constraints = {
  
  video: deviceId
  
  ? {
  
  deviceId: { exact: deviceId },
  
  width: { ideal: 1280 },
  
  height: { ideal: 720 },
  
  }
  
  : { width: { ideal: 1280 }, height: { ideal: 720 } },
  
  audio: false,
  
  };
  
  try {
  
  stream = await navigator.mediaDevices.getUserMedia(constraints);
  
  video.srcObject = stream;
  
  await new Promise((r) => {
  
  video.onloadedmetadata = r;
  
  });
  
  video.play();
  
  video.style.opacity = "1";
  
  noCam.style.display = "none";
  
  btnStart.style.display = "none";
  
  btnStop.style.display = "";
  
  btnAnalyse.disabled = false;
  
  btnLive.disabled = false;
  
  setStatus("Live", "live");
  
  initPose();
  
  } catch (e) {
  
  alert("Camera error: " + e.message);
  
  }
  
  }
  
  
  
  // silent=true means don't reset the dropdown or UI (used when switching cameras)
  
  function stopCam(silent) {
  
  if (stream) {
  
  stream.getTracks().forEach((t) => t.stop());
  
  stream = null;
  
  }
  
  if (mpCamera) {
  
  try {
  
  mpCamera.stop();
  
  } catch (e) {}
  
  mpCamera = null;
  
  }
  
  if (poseInst) {
  
  try {
  
  poseInst.close();
  
  } catch (e) {}
  
  poseInst = null;
  
  }
  
  video.style.opacity = "0";
  
  
  
  if (!silent) {
  
  noCam.style.display = "flex";
  
  btnStart.style.display = "";
  
  btnStop.style.display = "none";
  
  btnAnalyse.disabled = true;
  
  btnLive.disabled = true;
  
  setStatus("Camera off", "");
  
  phaseTxt.style.display = "none";
  
  if (liveOn) toggleLive();
  
  }
  
  }
  
  
  
  // =====================================================================
  
  // MEDIAPIPE POSE
  
  // =====================================================================
  
  function initPose() {
  
  poseInst = new Pose({
  
  locateFile: (f) =>
  
  "https://cdn.jsdelivr.net/npm/@mediapipe/pose@0.5.1675469404/" + f,
  
  });
  
  poseInst.setOptions({
  
  modelComplexity: 1,
  
  smoothLandmarks: true,
  
  minDetectionConfidence: 0.5,
  
  minTrackingConfidence: 0.5,
  
  });
  
  poseInst.onResults((results) => {
  
  if (results.poseLandmarks) {
  
  drawOverlay(results.poseLandmarks);
  
  drawStick(results.poseLandmarks);
  
  updateAngles(results.poseLandmarks);
  
  }
  
  });
  
  mpCamera = new Camera(video, {
  
  onFrame: async () => {
  
  if (poseInst) await poseInst.send({ image: video });
  
  },
  
  width: 1280,
  
  height: 720,
  
  });
  
  mpCamera.start();
  
  }
  
  
  
  // =====================================================================
  
  // CAPTURE FRAME
  
  // =====================================================================
  
  function captureFrame() {
  
  const c = document.createElement("canvas");
  
  c.width = video.videoWidth;
  
  c.height = video.videoHeight;
  
  const cx = c.getContext("2d");
  
  cx.save();
  
  cx.scale(-1, 1);
  
  cx.drawImage(video, -c.width, 0, c.width, c.height);
  
  cx.restore();
  
  return c.toDataURL("image/jpeg", 0.75).split(",")[1];
  
  }
  
  
  
  // =====================================================================
  
  // AI ANALYSIS (on-demand)
  
  // =====================================================================
  
  async function analyseNow() {
  
  if (isAnalysing || !stream) return;
  
  isAnalysing = true;
  
  btnAnalyse.disabled = true;
  
  aiOverlay.style.display = "flex";
  
  setStatus("Analysing...", "analyzing");
  
  
  
  const img = captureFrame();
  
  const aStr =
  
  lastAngles.shin !== undefined
  
  ? "Detected angles: shin " +
  
  lastAngles.shin +
  
  "deg, torso " +
  
  lastAngles.torso +
  
  "deg, hip " +
  
  lastAngles.hip +
  
  "deg, knee " +
  
  lastAngles.knee +
  
  "deg, elbow " +
  
  lastAngles.elbow +
  
  "deg."
  
  : "";
  
  
  
  try {
  
  const resp = await fetch("https://api.anthropic.com/v1/messages", {
  
  method: "POST",
  
  headers: { "Content-Type": "application/json" },
  
  body: JSON.stringify({
  
  model: "claude-sonnet-4-20250514",
  
  max_tokens: 900,
  
  system:
  
  "You are an expert rowing ergometer coach. Analyse the image of a rower. " +
  
  aStr +
  
  ' Respond ONLY with valid JSON, no markdown, no backticks: {"score":<0-100>,"grade":"<Poor|Fair|Good|Great|Excellent>","phase":"<catch|drive|finish|recovery|unknown>","feedback":[{"type":"<good|warn|bad>","label":"<short label>","text":"<coaching note>"}]} Give 3-4 feedback items. If no rower is visible, score 0 and explain.',
  
  messages: [
  
  {
  
  role: "user",
  
  content: [
  
  {
  
  type: "image",
  
  source: {
  
  type: "base64",
  
  media_type: "image/jpeg",
  
  data: img,
  
  },
  
  },
  
  { type: "text", text: "Analyse my rowing form." },
  
  ],
  
  },
  
  ],
  
  }),
  
  });
  
  
  
  const data = await resp.json();
  
  const raw = data.content
  
  .map((c) => c.text || "")
  
  .join("")
  
  .replace(/```json|```/g, "")
  
  .trim();
  
  const r = JSON.parse(raw);
  
  
  
  document.getElementById("scoreNum").textContent = r.score;
  
  document.getElementById("scoreGrade").textContent = r.grade;
  
  const gc = {
  
  Poor: "#E24B4A",
  
  Fair: "#EF9F27",
  
  Good: "#378ADD",
  
  Great: "#1D9E75",
  
  Excellent: "#4ade80",
  
  };
  
  document.getElementById("scoreGrade").style.color =
  
  gc[r.grade] || "#888";
  
  if (r.phase) {
  
  phaseTxt.textContent =
  
  r.phase.charAt(0).toUpperCase() + r.phase.slice(1);
  
  phaseTxt.style.display = "";
  
  }
  
  
  
  document.getElementById("feedbackWrap").innerHTML = r.feedback
  
  .map(
  
  (f) =>
  
  '<div class="fb-item ' +
  
  f.type +
  
  '"><div class="fb-label">' +
  
  f.label +
  
  "</div>" +
  
  f.text +
  
  "</div>"
  
  )
  
  .join("");
  
  } catch (e) {
  
  document.getElementById("feedbackWrap").innerHTML =
  
  '<div class="fb-item warn"><div class="fb-label">Error</div>' +
  
  e.message +
  
  "</div>";
  
  }
  
  
  
  isAnalysing = false;
  
  btnAnalyse.disabled = false;
  
  aiOverlay.style.display = "none";
  
  setStatus("Live", "live");
  
  }
  
  
  
  // =====================================================================
  
  // LIVE AI FEEDBACK (calls API on interval)
  
  // =====================================================================
  
  function toggleLive() {
  
  liveOn = !liveOn;
  
  btnLive.textContent = "Live feedback: " + (liveOn ? "on" : "off");
  
  btnLive.className = "btn" + (liveOn ? " active" : "");
  
  if (liveOn) {
  
  analyseNow();
  
  liveTimer = setInterval(analyseNow, 12000);
  
  } else {
  
  clearInterval(liveTimer);
  
  }
  
  }
  
  </script>
  
  </body>
  
  </html>

