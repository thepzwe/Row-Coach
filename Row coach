        <!-- Live rule-based feedback -->

        <div class="card" id="liveFbCard">
          <div class="card-title">Live feedback</div>

          <div class="live-fb-wrap" id="liveFbWrap">
            <div style="font-size: 12px; color: #444">
              Start camera to see live feedback.
            </div>
          </div>
        </div>

        <!-- Angles -->

        <div class="card">
          <div class="card-title">Live angles</div>

          <div class="angle-row">
            <span class="angle-name">Shin</span>

            <div class="angle-bar-wrap">
              <div class="angle-bar" id="bar-shin" style="width: 0%"></div>
            </div>

            <span class="angle-val" id="ang-shin">--</span>
          </div>

          <div class="angle-row">
            <span class="angle-name">Torso</span>

            <div class="angle-bar-wrap">
              <div class="angle-bar" id="bar-torso" style="width: 0%"></div>
            </div>

            <span class="angle-val" id="ang-torso">--</span>
          </div>

          <div class="angle-row">
            <span class="angle-name">Hip</span>

            <div class="angle-bar-wrap">
              <div class="angle-bar" id="bar-hip" style="width: 0%"></div>
            </div>

            <span class="angle-val" id="ang-hip">--</span>
