<!DOCTYPE html>

<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Rowing Form Coach</title>

    <!--

-->

    <style>
      *,
      *::before,
      *::after {
        box-sizing: border-box;

        margin: 0;

        padding: 0;
      }

      body {
        font-family: system-ui, sans-serif;

        background: #0f0f0f;

        color: #e0e0e0;

        min-height: 100vh;

        padding: 16px;
      }

      h1 {
        font-size: 20px;

        font-weight: 500;

        margin-bottom: 2px;
      }

      .subtitle {
        font-size: 13px;

        color: #888;

        margin-bottom: 14px;
      }

      .layout {
        display: grid;

        grid-template-columns: 1fr 280px;

        gap: 12px;
      }

      @media (max-width: 720px) {
        .layout {
          grid-template-columns: 1fr;
        }
      }

      /* camera */

      .cam-wrap {
        position: relative;

        background: #111;

        border-radius: 12px;

        overflow: hidden;

        border: 1px solid #2a2a2a;

        aspect-ratio: 16/9;
      }

      #video {
        position: absolute;

        top: 0;

        left: 0;

        width: 100%;

        height: 100%;

        object-fit: cover;

        transform: scaleX(-1);

        opacity: 0;

        transition: opacity 0.3s;

        display: block;
      }

      #overlay {
        position: absolute;

        top: 0;

        left: 0;

        width: 100%;

        height: 100%;

        pointer-events: none;
      }

      .no-cam {
        position: absolute;

        inset: 0;

        display: flex;

        flex-direction: column;

        align-items: center;

        justify-content: center;

        color: #555;

        gap: 10px;

        font-size: 13px;

        text-align: center;

        padding: 20px;
      }

      .no-cam .hint {
        font-size: 11px;

        color: #444;

        max-width: 260px;

        line-height: 1.6;
      }

      .ai-overlay {
        position: absolute;

        inset: 0;

        background: rgba(0, 0, 0, 0.45);

        display: none;

        align-items: center;

        justify-content: center;

        gap: 8px;

        color: #fff;

        font-size: 13px;
      }

      .spinner {
        width: 16px;

        height: 16px;

        border: 2px solid rgba(255, 255, 255, 0.2);

        border-top-color: #fff;

        border-radius: 50%;

        animation: spin 0.7s linear infinite;
      }

      @keyframes spin {
        to {
          transform: rotate(360deg);
        }
      }

      /* status */

      .status-bar {
        display: flex;

        align-items: center;

        gap: 8px;

        font-size: 12px;

        color: #888;

        margin-top: 8px;
      }

      .dot {
        width: 7px;

        height: 7px;

        border-radius: 50%;

        background: #444;

        flex-shrink: 0;
      }

      .dot.live {
        background: #4ade80;

        animation: blink 1.5s infinite;
      }

      .dot.analyzing {
        background: #facc15;

        animation: blink 0.6s infinite;
      }

      @keyframes blink {
        0%,
        100% {
          opacity: 1;
        }

        50% {
          opacity: 0.3;
        }
      }

      .phase-tag {
        font-size: 11px;

        background: #1e3a5f;

        color: #7bb8f5;

        padding: 2px 8px;

        border-radius: 99px;

        margin-left: auto;
      }

      /* camera picker */

      .cam-picker {
        display: flex;

        align-items: center;

        gap: 8px;

        margin-top: 10px;
      }

      .cam-picker label {
        font-size: 12px;

        color: #888;

        flex-shrink: 0;
      }

      .cam-picker select {
        flex: 1;

        background: #1a1a1a;

        color: #e0e0e0;

        border: 1px solid #333;

        border-radius: 8px;

        padding: 7px 10px;

        font-size: 13px;

        font-family: inherit;

        cursor: pointer;
      }

      .cam-picker select:focus {
        outline: none;

        border-color: #555;
      }

      /* controls */

      .controls {
        display: flex;

        gap: 8px;

        flex-wrap: wrap;

        margin-top: 8px;
      }

      .btn {
        border: 1px solid #333;

        background: #1a1a1a;

        color: #e0e0e0;

        border-radius: 8px;

        padding: 8px 14px;

        font-size: 13px;

        cursor: pointer;

        font-family: inherit;

        transition: background 0.15s;
      }

      .btn:hover {
        background: #252525;
      }

      .btn.primary {
        background: #e0e0e0;

        color: #0f0f0f;

        border-color: transparent;
      }

      .btn.primary:hover {
        background: #ccc;
      }

      .btn:disabled {
        opacity: 0.35;

        cursor: not-allowed;
      }

      .btn.active {
        background: #1e3a5f;

        color: #7bb8f5;

        border-color: #2a5280;
      }

      /* cards */

      .card {
        background: #1a1a1a;

        border: 1px solid #2a2a2a;

        border-radius: 12px;

        padding: 12px 14px;

        margin-bottom: 10px;
      }

      .card-title {
        font-size: 10px;

        font-weight: 500;

        text-transform: uppercase;

        letter-spacing: 0.06em;

        color: #666;

        margin-bottom: 10px;
      }

      /* score */

      .score-big {
        font-size: 40px;

        font-weight: 500;

        color: #e0e0e0;

        line-height: 1;

        text-align: center;
      }

      .score-grade {
        font-size: 14px;

        font-weight: 500;

        text-align: center;

        margin-top: 4px;
      }

      .score-label {
        font-size: 11px;

        color: #666;

        text-align: center;

        margin-top: 2px;
      }

      /* angles */

      .angle-row {
        display: flex;

        align-items: center;

        gap: 8px;

        padding: 5px 0;

        border-bottom: 1px solid #222;
      }

      .angle-row:last-child {
        border-bottom: none;
      }

      .angle-name {
        font-size: 12px;

        color: #888;

        width: 70px;

        flex-shrink: 0;
      }

      .angle-bar-wrap {
        flex: 1;

        height: 4px;

        background: #2a2a2a;

        border-radius: 2px;

        overflow: hidden;
      }

      .angle-bar {
        height: 100%;

        border-radius: 2px;

        background: #378add;

        transition: width 0.3s;
      }

      .angle-bar.good {
        background: #1d9e75;
      }

      .angle-bar.warn {
        background: #ef9f27;
      }

      .angle-val {
        font-size: 12px;

        font-weight: 500;

        color: #e0e0e0;

        font-family: monospace;

        width: 40px;

        text-align: right;

        flex-shrink: 0;
      }

      /* stick */

      .stick-wrap {
        display: flex;

        justify-content: center;
      }

      /* live feedback */

      .live-fb-wrap {
        display: flex;

        flex-direction: column;

        gap: 6px;
      }

      .live-fb {
        padding: 8px 10px;

        border-radius: 8px;

        border-left: 3px solid #333;

        background: #1a1a1a;

        font-size: 12px;

        line-height: 1.5;

        color: #ccc;

        transition: border-color 0.3s, background 0.3s;
      }

      .live-fb.good {
        border-left-color: #1d9e75;

        background: #0d1f17;
      }

      .live-fb.warn {
        border-left-color: #ef9f27;

        background: #1f1608;
      }

      .live-fb.bad {
        border-left-color: #e24b4a;

        background: #1f0d0d;
      }

      .live-fb-label {
        font-size: 10px;

        font-weight: 500;

        color: #555;

        text-transform: uppercase;

        letter-spacing: 0.05em;

        margin-bottom: 2px;
      }

      /* ai feedback */

      .fb-item {
        padding: 9px 11px;

        border-radius: 8px;

        border-left: 3px solid #333;

        background: #222;

        margin-bottom: 8px;

        font-size: 12px;

        line-height: 1.55;

        color: #ccc;
      }

      .fb-item.good {
        border-left-color: #1d9e75;
      }

      .fb-item.warn {
        border-left-color: #ef9f27;
      }

      .fb-item.bad {
        border-left-color: #e24b4a;
      }

      .fb-label {
        font-size: 10px;

        font-weight: 500;

        color: #666;

        text-transform: uppercase;

        letter-spacing: 0.05em;

        margin-bottom: 3px;
      }

      .section-sep {
        font-size: 10px;

        font-weight: 500;

        text-transform: uppercase;

        letter-spacing: 0.06em;

        color: #444;

        margin: 4px 0 8px;
      }
    </style>
  </head>

  <body>
    <h1>Rowing Form Coach</h1>

    <p class="subtitle">Live skeleton + real-time coaching</p>

    <div class="layout">
      <!-- LEFT: camera -->

      <div>
        <div class="cam-wrap" id="camWrap">
          <video id="video" autoplay playsinline muted></video>

          <canvas id="overlay"></canvas>

          <div class="no-cam" id="noCam">
            <svg
              width="36"
              height="36"
              viewBox="0 0 24 24"
              fill="none"
              stroke="#555"
              stroke-width="1.2"
            >
              <path d="M23 7l-7 5 7 5V7z" />

              <rect x="1" y="5" width="15" height="14" rx="2" />
            </svg>

            <span>Select a camera and click Start</span>

            <span class="hint"
              >If you see "Permission denied", open this page in a new tab —
